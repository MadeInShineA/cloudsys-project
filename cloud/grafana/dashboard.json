                      "spec": {
                        "expression": "SELECT\n  CASE\n    WHEN errors IS NULL THEN CASE\n      WHEN type = 'degraded' THEN CONCAT('type: ', type, ' (cause: ', cause, ')')\n      ELSE CONCAT('type: ', type)\n    END\n    ELSE CONCAT('errors: ', errors)\n  END AS body\nFROM\n  A",
                        "type": "sql"
