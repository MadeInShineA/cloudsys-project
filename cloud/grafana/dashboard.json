                        "expr": "SELECT * FROM \"group-8-alerts\" WHERE device_id = 'coffee-machine-0'",
                        "format": 1,
                        "legendFormat": "__auto",
                        "range": true,
                        "rawSql": "SELECT \n    \"timestamp\",\n    \"severity\",\n    \"type\",\n    \"errors\",\n    \"cause\"\nFROM \"group-8-alerts\"\nWHERE device_id = '$device_id'\n  AND (\"errors\" != '' AND \"errors\" IS NOT NULL AND \"type\" NOT IN ('overheat_predicted', 'oom_predicted'))\nORDER BY \"timestamp\" ASC;"
